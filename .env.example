# Supabase (required for local `npx expo start`)
# Also set these as EAS Environment Variables for cloud builds (see README → EAS Build).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: hosted HTTPS page for email confirmation (must serve real text/html).
# Default is the in-app deep link forge://email-verified
# EXPO_PUBLIC_EMAIL_REDIRECT_URL=https://your-static-host.example/email-verified.html

# App environment (optional)
APP_ENV=development

# AI Coach (server-side only — set as a Supabase Edge Function secret, NOT in the app)
# supabase secrets set GROQ_API_KEY=...
# supabase functions deploy ai-coach
